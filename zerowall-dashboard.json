      "y": 0,
      "width": 24,
      "height": 1,
      "properties": {
        "markdown": "# ZeroWall Monitoring Dashboard\nReal-time view of API security posture and traffic. Custom metrics on top, Lambda health in the middle, DynamoDB usage at the bottom."
      }
    },

    {
      "type": "metric",
      "x": 0,
      "y": 1,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Auth Failures (1m sum)",
        "metrics": [
          ["zerowall", "AuthFailures", {"stat": "Sum", "label": "AuthFailures"}]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-2",
        "period": 60,
        "yAxis": {"left": {"min": 0}},
        "annotations": {
          "horizontal": [
            {"label": "Alarm threshold (>20 in 5m)", "value": 20}
          ]
        }
      }
    },

