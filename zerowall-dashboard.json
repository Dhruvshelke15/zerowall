        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-2",
        "period": 60,
        "yAxis": {"left": {"min": 0}},
        "annotations": {
          "horizontal": [
            {"label": "Alarm threshold (avg >3000ms)", "value": 3000}
          ]
        }
      }
    },

